# Derivados regeneráveis — nunca versionar (regenerados a partir da canonica.md)
**/saidas/

# Atividades impressas: o .html é a fonte editável; o .pdf sai dele via print
aulas/**/atividades/*.pdf

# Projetos e materiais fora do fluxo de aulas canônicas — local-only (parecer ASTRA,
# 2026-11-15). Robótica tem firmware com credenciais fixas e um repo git próprio
# aninhado (automatiza_zap); a feira são apresentações e PDFs pesados. Ignorar não é
# backup: a cópia dessas pastas depende do Backupeador (espelho de D:\ em E:\).
/aulas/robotica/
/aulas/introducao-a-computacao/feiradoconhecimento/

# Links locais para o Codex achar as skills do vault (.agents/skills/* -> .claude/skills/*).
# Fora do git: o repo usa core.symlinks=false. Recriar: ver "Comandos úteis" no AGENTS.md.
/.agents/

# Saídas de ferramenta — regeneráveis, local-only
graphify-out/
.playwright-mcp/
scratch/

# Temporários e backups
*.tmp
*.bak
*.swp
*~
codex-session-*.md

# Lixo de SO
.DS_Store
Thumbs.db
desktop.ini

# Editores
.idea/
*.code-workspace
.obsidian/

# Python / venv (ferramentas)
.venv/
__pycache__/
*.pyc
_inspecionar.py

# Referência externa de terceiros (ex.: wiki de curso pago) — local-only, não republicar
lake/**/elite-wiki/

# Conteúdo bruto no lake — pesado, não versionar (só os .md tratados entram)
# Vídeo/áudio
lake/**/*.mp4
lake/**/*.mkv
lake/**/*.mov
lake/**/*.avi
lake/**/*.mp3
lake/**/*.wav
lake/**/*.m4a
